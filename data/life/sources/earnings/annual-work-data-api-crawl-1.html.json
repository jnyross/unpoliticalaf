ontrols=\"collapsible-0\">\n                        <h2 class=\"show-hide__title padding-left-sm--1 padding-left-md--4\">\n                            <span class=\"icon icon-info icon-info--info-box hide--sm\"></span>\n                            \n                                \n                                    Correction\n                                 \n                            \n                        </h2>\n                    </button></div>\n                    <div class=\"js-show-hide__content\" id=\"collapsible-0\" aria-hidden=\"true\">\n                        \n                            <div class=\"show-hide__content alert--warning__content section__content--markdown padding-bottom--1\">\n                                \n                                <section>\n                                    \n                                        <p class=\"alert__date\">12 March 2026</p>\n                                        <p>An error has been identified in Table 9 of our Annual Survey of Hours and Earnings time series of selected estimates dataset. This affects the percentage annual change of median gross weekly earnings for the private sector from 2021 to 2025. We apologise for this error which has now been corrected.</p>\n\n                                    \n                                </section>\n                            </div>\n                        \n\n                        \n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n\n<div class=\"meta-wrap\">\n    <div class=\"wrapper\">\n        \n        <ul class=\"col-wrap meta__list\">\n            <li class=\"col col--md-12 col--lg-15 meta__item\">\n                \n                <a href=\"https://uksa.statisticsauthority.gov.uk/about-the-authority/uk-statistical-system/types-of-official-statistics/\">\n                    <img class=\"meta__image\" src=\"https://cdn.ons.gov.uk/assets/images/ons-logo/kitemark/v2/uksa-kitemark-en.svg\" alt=\"Official Statistics logo\">\n                </a>\n                \n                <div class=\"meta__term\">Contact:</div>\n                <div>\n                    \n                        <a href=\"mailto:earnings@ons.gov.uk\">Earnings team</a>\n                    \n                </div>\n            </li>\n            <li class=\"col col--md-12 col--lg-15 meta__item\">\n                <div class=\"meta__term\">Release date:</div>\n                <div>22 October 2026</div>\n            </li>\n            <li class=\"col col--md-12 col--lg-15 meta__item\">\n                <div class=\"meta__term\">Next release:</div>\n                <div>\n                    \n                        To be announced\n                    \n                </div>\n            </li>\n            \n        </ul>\n    </div>\n</div>\n\n<div class=\"wrapper\">\n        <div class=\"col-wrap margin-bottom--4\">\n            <div class=\"col col--lg-two-thirds col--md-two-thirds\">\n                \n                    <section>\n                        <h2>About this Dataset</h2>\n                        Selected annual estimates of earnings and paid hours worked by UK employees using ASHE data from 1997.\n                    </section>\n                \n                <section>\n                    \n                    <h2 class=\"margin-bottom--2\">Edition in this dataset</h2>\n                    \n                    \n                        \n                            \n                            <div class=\"show-hide show-hide--light js-show-hide border-top--abbey-sm border-top--abbey-md border-top--abbey-lg border-bottom--abbey-sm border-bottom--abbey-md border-bottom--abbey-lg\">\n                                <div class=\"js-show-hide__title is-shown\"><button class=\"js-show-hide__button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"collapsible-1\">\n                                    <h3 class=\"margin-top--0 margin-bottom--0\">Current edition of this dataset </h3>\n                                </button></div>\n                                <div class=\"js-show-hide__content\" id=\"collapsible-1\" aria-hidden=\"false\">\n                                    <div class=\"margin-bottom--2\">\n                                        \n                                            <div class=\"inline-block--md margin-bottom-sm--1\">\n                                                <a href=\"/file?uri=/employmentandlabourmarket/peopleinwork/earningsandworkinghours/datasets/ashe1997to2015selectedestimates/current/selectedestimates19972026.xlsx\" class=\"btn btn--primary btn--thick\" aria-label=\"Download Annual Survey of Hours and Earnings time series of selected estimates: Current in xlsx format\">\n                                                    \n                                                        <span>xlsx (284.4 KB)</span>\n                                                    \n                                                </a>\n                                            </div>\n                                        \n                                    </div>\n                                    \n                                        <p class=\"margin-top--0\">\n                                            <span class=\"icon icon-info--inline\"></span>\n                                            <a href=\"/employmentandlabourmarket/peopleinwork/earningsandworkinghours/datasets/ashe1997to2015selectedestimates/current\" class=\"underline-link margin-left--3\">Previous versions </a> of this data are available.\n                                        </p>\n                                    \n                                    \n                                </div>\n                            </div>\n                        \n                        \n                    \n                </section>\n\n                \n\n            </div>\n         