{
  "name": "UnpoliticalAF",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "make setup-dev && .venv/bin/python -m playwright install --with-deps chromium",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Static site preview",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.unittestEnabled": true,
        "python.testing.pytestEnabled": false,
        "python.testing.unittestArgs": ["-v", "-s", "tests"]
      }
    }
  }
}
